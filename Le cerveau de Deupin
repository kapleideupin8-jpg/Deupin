const path = require('path');
const express = require('express');
const helmet = require('helmet');
const rateLimit = require('express-rate-limit');
const Anthropic = require('@anthropic-ai/sdk');

const app = express();
const PORT = process.env.PORT || 3000;

if (process.env.TRUST_PROXY === '1' || process.env.NODE_ENV === 'production') {
  app.set('trust proxy', 1);
}

app.use(
  helmet({
    contentSecurityPolicy: {
      directives: {
        defaultSrc: ["'self'"],
        scriptSrc: ["'self'", "'unsafe-inline'", "'unsafe-eval'", "https://cdn.jsdelivr.net"],
        styleSrc: ["'self'", "'unsafe-inline'", "https://fonts.googleapis.com"],
        fontSrc: ["'self'", "https://fonts.gstatic.com", "data:"],
        imgSrc: ["'self'", "data:", "blob:"],
        connectSrc: ["'self'"],
      },
    },
  })
);

app.use(express.json({ limit: '10mb' }));

const limiter = rateLimit({
  windowMs: (parseInt(process.env.RATE_WINDOW_MIN, 10) || 15) * 60 * 1000,
  max: parseInt(process.env.RATE_MAX, 10) || 50,
  message: { error: "Trop de requêtes. Patiente quelques minutes." },
  standardHeaders: true,
  legacyHeaders: false,
});
app.use('/api/', limiter);

// Bibliothèques
app.use('/vendor/marked', express.static(path.join(__dirname, 'node_modules/marked')));
app.use('/vendor/purify', express.static(path.join(__dirname, 'node_modules/dompurify/dist')));

app.use(express.static(path.join(__dirname, 'public'), {
  maxAge: process.env.NODE_ENV === 'production' ? '1h' : 0,
}));

app.get('/healthz', (req, res) => res.status(200).send('OK'));

const apiKey = process.env.ANTHROPIC_API_KEY;
let anthropicClient = null;
if (apiKey) {
  anthropicClient = new Anthropic({ apiKey });
}

const getValidCodes = () => {
  const raw = process.env.ACCESS_CODES || '';
  return raw.split(',').map((c) => c.trim().toUpperCase()).filter(Boolean);
};

const MODEL_NAME = process.env.ANTHROPIC_MODEL || 'claude-sonnet-5-5';

app.post('/api/chat', async (req, res) => {
  const { messages, code, system } = req.body;

  const validCodes = getValidCodes();
  if (validCodes.length > 0) {
    const userCode = (code || '').toString().trim().toUpperCase();
    if (!validCodes.includes(userCode)) {
      return res.status(401).json({ error: "Code d'accès incorrect." });
    }
  }

  if (!anthropicClient) {
    return res.status(503).json({ error: "Clé API non configurée sur le serveur Render." });
  }

  if (!messages || !Array.isArray(messages) || messages.length === 0) {
    return res.status(400).json({ error: "Message manquant." });
  }

  res.setHeader('Content-Type', 'text/event-stream; charset=utf-8');
  res.setHeader('Cache-Control', 'no-cache, no-transform');
  res.setHeader('Connection', 'keep-alive');

  try {
    const stream = await anthropicClient.messages.stream({
      model: MODEL_NAME,
      max_tokens: 3000,
      system: system || "Tu es Deupin, professeur et tuteur ivoirien d'excellence pour le CEPE, le BEPC, le BAC et le Supérieur.",
      messages: messages,
    });

    for await (const chunk of stream) {
      if (chunk.type === 'content_block_delta' && chunk.delta?.text) {
        res.write(`data: ${JSON.stringify({ text: chunk.delta.text })}\n\n`);
      }
    }

    res.write('data: [DONE]\n\n');
    res.end();
  } catch (err) {
    console.error('Erreur API :', err);
    res.write(`data: ${JSON.stringify({ error: "Erreur de connexion avec l'IA. Réessaie dans quelques instants." })}\n\n`);
    res.end();
  }
});

app.get('*', (req, res) => {
  res.sendFile(path.join(__dirname, 'public', 'index.html'));
});

app.listen(PORT, () => {
  console.log(`Serveur actif sur le port ${PORT}`);
});
